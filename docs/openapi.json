    "/api/v1/scans/{id}/packages/{package_id}/paths": {
      "get": {
        "summary": "Representative simple application-to-package paths.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "package_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "max_paths",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "Maximum representative paths to display. Invalid values return 400. The legacy limit alias is also accepted."
          },
          {
            "name": "application_id",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Restrict representative paths to one application in this scan."
          },
          {
            "name": "max_depth",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 100
            },
            "description": "Traversal depth safety bound. Bounded results are never labelled exact."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Paths"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
