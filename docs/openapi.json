  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "repository_url": {
            "type": "string",
            "format": "uri"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Scan": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "commit_sha": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "progress": {
            "type": "integer"
          },
          "incomplete": {
            "type": "boolean"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "enrichment_status": {
            "enum": [
              "NOT_RUN",
              "COMPLETE",
              "PARTIAL",
              "DEGRADED"
            ]
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "error_message": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string"
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Graph": {
        "type": "object",
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source",
                "target"
              ],
              "properties": {
                "source": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "direct": {
                  "type": "boolean"
                },
                "source_evidence": {
                  "type": "string"
                },
                "constraint": {
                  "type": "string"
                },
                "group": {
                  "type": "string"
                },
                "marker": {
                  "type": "string"
                },
                "confidence": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          }
        }
      },
      "PackageDetail": {
        "type": "object",
        "properties": {
          "package": {
            "type": "object",
            "additionalProperties": true
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "dependents": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "Paths": {
        "type": "object",
        "required": [
          "paths",
          "path_lengths",
          "total_paths",
          "count_exact",
          "count_capped",
          "maximum_depth",
          "maximum_depth_exact",
          "evidence_complete"
        ],
        "properties": {
          "paths": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "truncated": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "path_lengths": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "applications": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "total_paths": {
            "type": "integer",
            "minimum": 0,
            "description": "Exact when count_exact=true; otherwise a lower bound within the stated limits."
          },
          "count_exact": {
            "type": "boolean"
          },
          "count_capped": {
            "type": "boolean"
          },
          "count_limit": {
            "type": "integer",
            "default": 1000
          },
          "maximum_depth": {
            "type": "integer",
            "minimum": 0
          },
          "maximum_depth_exact": {
            "type": "boolean",
            "description": "False means maximum observed within bounded results."
          },
          "max_depth_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "depth_limited": {
            "type": "boolean"
          },
          "cycles_detected": {
            "type": "boolean"
          },
          "evidence_confidence": {
            "type": "string",
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "evidence_complete": {
            "type": "boolean"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Impact": {
        "type": "object",
        "required": [
          "package_id",
          "downstream_packages",
          "immediate_dependent_packages",
          "transitive_dependent_packages",
          "applications_exposed",
          "application_ids",
          "affected_node_ids",
          "reachability_exact",
          "evidence_complete",
          "paths"
        ],
        "properties": {
          "package_id": {
            "type": "string"
          },
          "downstream_packages": {
            "type": "integer",
            "minimum": 0
          },
          "immediate_dependent_packages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "transitive_dependent_packages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "applications_exposed": {
            "type": "integer",
            "minimum": 0
          },
          "application_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "affected_node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reachability_exact": {
            "type": "boolean",
            "description": "Exact for the persisted isolated scan snapshot, not a claim that dependency discovery was complete."
          },
          "evidence_confidence": {
            "type": "string",
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "evidence_complete": {
            "type": "boolean"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "paths": {
            "$ref": "#/components/schemas/Paths"
          },
          "blast_radius": {
            "$ref": "#/components/schemas/BlastRadius"
          },
          "structural_criticality": {
            "$ref": "#/components/schemas/StructuralCriticality"
          }
        }
      },
      "Severity": {
        "type": "object",
        "required": [
          "type",
          "score"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "score": {
            "type": "string",
            "description": "Provider-supplied CVSS vector/score or label. Not a computed risk score."
          },
          "source": {
            "type": "string"
          }
        }
      },
      "Advisory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "aliases": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "details": {
            "type": "string"
          },
          "severity": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/Severity"
            }
          },
          "references": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          },
          "affected": {
            "description": "Matching OSV affected entries, including versions and ranges."
          },
          "fixed_versions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "raw_metadata": {
            "type": "object",
            "additionalProperties": true
          },
          "match_confidence": {
            "type": "string"
          },
          "match_evidence": {
            "type": "string"
          }
        }
      },
      "Finding": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "scan_id": {
            "type": "string"
          },
          "package_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "ecosystem": {
            "type": "string"
          },
          "purl": {
            "type": "string"
          },
          "advisory_id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "dependency_confidence": {
            "type": "string"
          },
          "vulnerability_match_confidence": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          },
          "direct": {
            "type": "boolean"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "explanation": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "advisories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Advisory"
            }
          }
        }
      },
      "PackageCheck": {
        "type": "object",
        "properties": {
          "package_id": {
            "type": "string"
          },
          "purl": {
            "type": "string"
          },
          "status": {
            "enum": [
              "CHECKED",
              "PARTIAL",
              "FAILED",
              "SKIPPED",
              "UNQUERIED"
            ]
          },
          "reason": {
            "type": "string"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "advisories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Advisory"
            }
          }
        }
      },
      "Enrichment": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "NOT_RUN",
              "COMPLETE",
              "PARTIAL",
              "DEGRADED"
            ]
          },
          "provider": {
            "type": "string"
          },
          "graph_status": {
            "enum": [
              "NOT_RUN",
              "COMPLETE",
              "DEGRADED"
            ]
          },
          "error": {
            "type": "string"
          },
          "packages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PackageCheck"
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Finding"
            }
          }
        }
      },
      "BlastRadius": {
        "type": "object",
        "required": [
          "score",
          "classification",
          "reason_codes",
          "total_applications",
          "total_packages",
          "components"
        ],
        "properties": {
          "score": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "classification": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "INCOMPLETE_DEPENDENCY_EVIDENCE",
                "SCAN_PATH_COUNT_CAPPED",
                "SCAN_PATH_DEPTH_LIMIT",
                "WORK_LIMIT",
                "EXECUTION_LIMIT"
              ]
            }
          },
          "blocking_package": {
            "type": "string"
          },
          "total_applications": {
            "type": "integer"
          },
          "total_packages": {
            "type": "integer"
          },
          "components": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "object",
              "properties": {
                "numerator": {
                  "type": "number"
                },
                "denominator": {
                  "type": "number"
                },
                "value": {
                  "type": "number"
                },
                "weight": {
                  "type": "number"
                },
                "contribution": {
                  "type": "number"
                }
              }
            }
          }
        }
      },
      "StructuralCriticality": {
        "type": "object",
        "description": "Scan-relative topology score. It is independent of advisories, CVSS, exploitability, and business criticality.",
        "required": [
          "score",
          "reason_codes",
          "total_applications",
          "total_packages",
          "components"
        ],
        "properties": {
          "score": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 100
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "INCOMPLETE_DEPENDENCY_EVIDENCE",
                "SCAN_PATH_COUNT_CAPPED",
                "SCAN_PATH_DEPTH_LIMIT",
                "WORK_LIMIT",
                "EXECUTION_LIMIT"
              ]
            }
          },
          "blocking_package": {"type": "string"},
          "total_applications": {"type": "integer"},
          "total_packages": {"type": "integer"},
          "components": {
            "type": ["object", "null"],
            "additionalProperties": {
              "type": "object",
              "properties": {
                "numerator": {"type": "number"},
                "denominator": {"type": "number"},
                "value": {"type": "number"},
                "weight": {"type": "number"},
                "contribution": {"type": "number"}
              }
            }
          }
        }
      }
    }
  }
}
