              }
            }
          }
        }
      }
    },
    "/api/v1/scans/{id}/findings": {
      "get": {
        "summary": "Complete stored enrichment report including per-package coverage and findings; not paginated.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Enrichment"
                }
              }
            }
          },
          "400": {
            "description": "Error",
